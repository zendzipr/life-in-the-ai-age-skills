{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zendzipr/life-in-the-ai-age-skills/schemas/registry.schema.json",
  "title": "Life in the AI Age Skill Registry",
  "type": "object",
  "required": ["project", "repository", "visibility", "canonical_branch", "skills"],
  "properties": {
    "$schema": {"type": "string"},
    "project": {"const": "Life in the AI Age"},
    "repository": {"type": "string", "format": "uri"},
    "visibility": {"enum": ["private", "public"]},
    "canonical_branch": {"type": "string", "minLength": 1},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "status", "owner", "path", "description", "evaluation_status", "checksums"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "status": {"enum": ["draft", "candidate", "released", "deprecated", "archived"]},
          "owner": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^skills/"},
          "description": {"type": "string", "minLength": 1, "maxLength": 60},
          "evaluation_status": {"type": "string", "minLength": 1},
          "checksums": {
            "type": "object",
            "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
